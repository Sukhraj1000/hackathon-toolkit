module Mandate where

import DA.Text qualified as Text
import Splice.Api.Token.HoldingV1
import Splice.Api.Token.MetadataV1
import Splice.Api.Token.TransferInstructionV1


maxMandateIdLength : Int
maxMandateIdLength = 128


maxBusinessReferenceLength : Int
maxBusinessReferenceLength = 128


isBoundedNonEmptyText : Int -> Text -> Bool
isBoundedNonEmptyText maximumLength value =
  Text.isNotEmpty (Text.trim value) && Text.length value <= maximumLength


-- The registry supplies only opaque, ledger-derived execution context and
-- owner holding references. Every material payment field is derived from the
-- checked mandate and Charge arguments below.
data TokenExecution = TokenExecution with
    transferFactoryCid : ContractId TransferFactory
    inputHoldingCids : [ContractId Holding]
    choiceContext : ChoiceContext
  deriving (Show, Eq)


fetchCompatibleHoldings
  : Party
  -> InstrumentId
  -> [ContractId Holding]
  -> Update [HoldingView]
fetchCompatibleHoldings expectedOwner expectedInstrument holdingCids =
  case holdingCids of
    [] -> pure []
    holdingCid :: remainingCids -> do
      holding <- fetch holdingCid
      let holdingView = view holding
      assertMsg
        "holding owner does not match mandate owner"
        (holdingView.owner == expectedOwner)
      assertMsg
        "holding instrument or administrator does not match mandate"
        (holdingView.instrumentId == expectedInstrument)
      assertMsg "holding amount must be positive" (holdingView.amount > 0.0)
      assertMsg "locked holding is not spendable" (holdingView.lock == None)
      remaining <-
        fetchCompatibleHoldings expectedOwner expectedInstrument remainingCids
      pure (holdingView :: remaining)


-- The immutable policy an owner grants to one designated agent.
template Mandate
  with
    mandateId : Text
    owner : Party
    agent : Party
    instrumentId : Text
    expectedAdmin : Party
    totalCap : Decimal
    allowedCounterparties : [Party]
    expiresAt : Time
  where
    ensure
      isBoundedNonEmptyText maxMandateIdLength mandateId
        && totalCap > 0.0

    signatory owner
    observer agent

    -- Archiving the static policy invalidates every usage contract that
    -- references it. No agent authorization is required.
    choice Revoke : ()
      controller owner
      do pure ()


-- Owner and agent jointly authorize creation of the usage chain, so neither
-- party can fabricate a replacement state alone. Consuming the current usage
-- serializes charges against that chain.
template MandateUsage
  with
    mandateCid : ContractId Mandate
    mandateId : Text
    owner : Party
    agent : Party
    instrumentId : Text
    expectedAdmin : Party
    totalCap : Decimal
    allowedCounterparties : [Party]
    expiresAt : Time
    spent : Decimal
    processedReferences : [Text]
  where
    ensure
      isBoundedNonEmptyText maxMandateIdLength mandateId
        && Text.isNotEmpty (Text.trim instrumentId)
        && totalCap > 0.0
        && spent >= 0.0
        && spent <= totalCap

    signatory owner, agent

    -- The agent supplies only purchase-specific data. Every policy field is
    -- fetched from the immutable mandate and every consequence commits in the
    -- same transaction.
    choice Charge : (ContractId MandateUsage, ContractId ChargeReceipt)
      with
        merchant : Party
        amount : Decimal
        businessReference : Text
        tokenExecution : TokenExecution
      controller agent
      do
        mandate <- fetch mandateCid
        now <- getTime
        let spentAfter = spent + amount

        assertMsg "usage owner does not match mandate" (owner == mandate.owner)
        assertMsg "usage agent does not match mandate" (agent == mandate.agent)
        assertMsg
          "usage mandate id does not match mandate"
          (mandateId == mandate.mandateId)
        assertMsg
          "usage instrument does not match mandate"
          (instrumentId == mandate.instrumentId)
        assertMsg
          "usage token administrator does not match mandate"
          (expectedAdmin == mandate.expectedAdmin)
        assertMsg
          "usage total cap does not match mandate"
          (totalCap == mandate.totalCap)
        assertMsg
          "usage counterparty allow-list does not match mandate"
          (allowedCounterparties == mandate.allowedCounterparties)
        assertMsg
          "usage expiry does not match mandate"
          (expiresAt == mandate.expiresAt)
        assertMsg "amount must be positive" (amount > 0.0)
        assertMsg
          "business reference must be non-empty and at most 128 symbols"
          (isBoundedNonEmptyText
            maxBusinessReferenceLength
            businessReference)
        assertMsg
          "business reference already processed"
          (businessReference `notElem` processedReferences)
        assertMsg
          "counterparty not allowed"
          (merchant `elem` mandate.allowedCounterparties)
        assertMsg "total cap exceeded" (spentAfter <= mandate.totalCap)
        assertMsg "mandate expired" (now < mandate.expiresAt)

        let mandateInstrument = InstrumentId with
              admin = mandate.expectedAdmin
              id = mandate.instrumentId

        assertMsg
          "at least one owner holding is required"
          (not (null tokenExecution.inputHoldingCids))
        inputHoldings <- fetchCompatibleHoldings
          mandate.owner
          mandateInstrument
          tokenExecution.inputHoldingCids
        assertMsg
          "owner holdings do not cover the charge amount"
          (sum (map (\holding -> holding.amount) inputHoldings) >= amount)

        -- PublicFetch binds an untrusted factory contract ID to the
        -- administrator pinned by the mandate before it can be exercised.
        factoryView <- exercise
          tokenExecution.transferFactoryCid
          TransferFactory_PublicFetch with
            expectedAdmin = mandate.expectedAdmin
            actor = mandate.owner
        assertMsg
          "transfer factory administrator does not match mandate"
          (factoryView.admin == mandate.expectedAdmin)

        let transfer = Transfer with
              sender = mandate.owner
              receiver = merchant
              amount
              instrumentId = mandateInstrument
              requestedAt = now
              executeBefore = mandate.expiresAt
              inputHoldingCids = tokenExecution.inputHoldingCids
              meta = emptyMetadata
        transferResult <- exercise
          tokenExecution.transferFactoryCid
          TransferFactory_Transfer with
            expectedAdmin = mandate.expectedAdmin
            transfer
            extraArgs = ExtraArgs with
              context = tokenExecution.choiceContext
              meta = emptyMetadata

        receiverHoldingCids <- case transferResult.output of
          TransferInstructionResult_Completed completedHoldingCids ->
            pure completedHoldingCids
          TransferInstructionResult_Pending _ ->
            abort "token transfer did not complete immediately"
          TransferInstructionResult_Failed ->
            abort "token transfer failed"

        assertMsg
          "completed transfer returned no receiver holdings"
          (not (null receiverHoldingCids))

        usageCid <- create this with
          spent = spentAfter
          processedReferences = businessReference :: processedReferences
        receiptCid <- create ChargeReceipt with
          mandateCid
          mandateId
          owner
          agent
          merchant
          instrumentId = mandate.instrumentId
          amount
          spentBefore = spent
          spentAfter
          chargedAt = now
          businessReference
        pure (usageCid, receiptCid)


-- A typed constructor avoids ambiguous duplicate record labels for Daml Script
-- clients while keeping the terminal policy snapshot explicit.
makeMandateUsage
  : ContractId Mandate
  -> Text
  -> Party
  -> Party
  -> Text
  -> Party
  -> Decimal
  -> [Party]
  -> Time
  -> Decimal
  -> [Text]
  -> MandateUsage
makeMandateUsage
    mandateCid mandateId owner agent instrumentId expectedAdmin totalCap
    allowedCounterparties expiresAt spent processedReferences =
  MandateUsage with
    mandateCid
    mandateId
    owner
    agent
    instrumentId
    expectedAdmin
    totalCap
    allowedCounterparties
    expiresAt
    spent
    processedReferences


-- Requiring both authorities prevents either from fabricating a receipt alone.
-- Replay protection lives in the consuming MandateUsage chain so it remains
-- supported on Canton 3.x, where unique contract keys are unavailable.
template ChargeReceipt
  with
    mandateCid : ContractId Mandate
    mandateId : Text
    owner : Party
    agent : Party
    merchant : Party
    instrumentId : Text
    amount : Decimal
    spentBefore : Decimal
    spentAfter : Decimal
    chargedAt : Time
    businessReference : Text
  where
    ensure
      isBoundedNonEmptyText maxMandateIdLength mandateId
        && isBoundedNonEmptyText
          maxBusinessReferenceLength
          businessReference
        && amount > 0.0
        && spentBefore >= 0.0
        && spentAfter == spentBefore + amount

    signatory owner, agent
    observer merchant

-- The owner proposes the complete immutable policy. The named agent accepts
-- it once, atomically creating the policy and zero-spend usage state.
template MandateProposal
  with
    mandateId : Text
    owner : Party
    agent : Party
    instrumentId : Text
    expectedAdmin : Party
    totalCap : Decimal
    allowedCounterparties : [Party]
    expiresAt : Time
  where
    ensure
      isBoundedNonEmptyText maxMandateIdLength mandateId
        && totalCap > 0.0

    signatory owner
    observer agent

    choice Accept : (ContractId Mandate, ContractId MandateUsage)
      controller agent
      do
        mandateCid <- create Mandate with
          mandateId
          owner
          agent
          instrumentId
          expectedAdmin
          totalCap
          allowedCounterparties
          expiresAt
        usageCid <- create MandateUsage with
          mandateCid
          mandateId
          owner
          agent
          instrumentId
          expectedAdmin
          totalCap
          allowedCounterparties
          expiresAt
          spent = 0.0
          processedReferences = []
        pure (mandateCid, usageCid)

    choice Reject : ()
      controller agent
      do pure ()
