module Mandate where

import DA.Text qualified as Text


maxMandateIdLength : Int
maxMandateIdLength = 128


maxBusinessReferenceLength : Int
maxBusinessReferenceLength = 128


isBoundedNonEmptyText : Int -> Text -> Bool
isBoundedNonEmptyText maximumLength value =
  Text.isNotEmpty (Text.trim value) && Text.length value <= maximumLength


-- The immutable policy an owner grants to one designated agent.
template Mandate
  with
    mandateId : Text
    owner : Party
    agent : Party
    instrumentId : Text
    expectedAdmin : Party
    totalCap : Decimal
    allowedCounterparties : [Party]
    expiresAt : Time
  where
    ensure
      isBoundedNonEmptyText maxMandateIdLength mandateId
        && totalCap > 0.0

    signatory owner
    observer agent

    -- Archiving the static policy invalidates every usage contract that
    -- references it. No agent authorization is required.
    choice Revoke : ()
      controller owner
      do pure ()


-- Owner and agent jointly authorize creation of the usage chain, so neither
-- party can fabricate a replacement state alone. Consuming the current usage
-- serializes charges against that chain.
template MandateUsage
  with
    mandateCid : ContractId Mandate
    mandateId : Text
    owner : Party
    agent : Party
    spent : Decimal
    processedReferences : [Text]
  where
    ensure
      isBoundedNonEmptyText maxMandateIdLength mandateId
        && spent >= 0.0

    signatory owner, agent

    -- The agent supplies only purchase-specific data. Every policy field is
    -- fetched from the immutable mandate and every consequence commits in the
    -- same transaction.
    choice Charge : (ContractId MandateUsage, ContractId ChargeReceipt)
      with
        merchant : Party
        amount : Decimal
        businessReference : Text
      controller agent
      do
        mandate <- fetch mandateCid
        now <- getTime
        let spentAfter = spent + amount

        assertMsg "usage owner does not match mandate" (owner == mandate.owner)
        assertMsg "usage agent does not match mandate" (agent == mandate.agent)
        assertMsg
          "usage mandate id does not match mandate"
          (mandateId == mandate.mandateId)
        assertMsg "amount must be positive" (amount > 0.0)
        assertMsg
          "business reference must be non-empty and at most 128 symbols"
          (isBoundedNonEmptyText
            maxBusinessReferenceLength
            businessReference)
        assertMsg
          "business reference already processed"
          (businessReference `notElem` processedReferences)
        assertMsg
          "counterparty not allowed"
          (merchant `elem` mandate.allowedCounterparties)
        assertMsg "total cap exceeded" (spentAfter <= mandate.totalCap)
        assertMsg "mandate expired" (now < mandate.expiresAt)

        usageCid <- create this with
          spent = spentAfter
          processedReferences = businessReference :: processedReferences
        receiptCid <- create ChargeReceipt with
          mandateCid
          mandateId
          owner
          agent
          merchant
          instrumentId = mandate.instrumentId
          amount
          spentBefore = spent
          spentAfter
          chargedAt = now
          businessReference
        pure (usageCid, receiptCid)


-- Requiring both authorities prevents either from fabricating a receipt alone.
-- Replay protection lives in the consuming MandateUsage chain so it remains
-- supported on Canton 3.x, where unique contract keys are unavailable.
template ChargeReceipt
  with
    mandateCid : ContractId Mandate
    mandateId : Text
    owner : Party
    agent : Party
    merchant : Party
    instrumentId : Text
    amount : Decimal
    spentBefore : Decimal
    spentAfter : Decimal
    chargedAt : Time
    businessReference : Text
  where
    ensure
      isBoundedNonEmptyText maxMandateIdLength mandateId
        && isBoundedNonEmptyText
          maxBusinessReferenceLength
          businessReference
        && amount > 0.0
        && spentBefore >= 0.0
        && spentAfter == spentBefore + amount

    signatory owner, agent
    observer merchant

-- The owner proposes the complete immutable policy. The named agent accepts
-- it once, atomically creating the policy and zero-spend usage state.
template MandateProposal
  with
    mandateId : Text
    owner : Party
    agent : Party
    instrumentId : Text
    expectedAdmin : Party
    totalCap : Decimal
    allowedCounterparties : [Party]
    expiresAt : Time
  where
    ensure
      isBoundedNonEmptyText maxMandateIdLength mandateId
        && totalCap > 0.0

    signatory owner
    observer agent

    choice Accept : (ContractId Mandate, ContractId MandateUsage)
      controller agent
      do
        mandateCid <- create Mandate with
          mandateId
          owner
          agent
          instrumentId
          expectedAdmin
          totalCap
          allowedCounterparties
          expiresAt
        usageCid <- create MandateUsage with
          mandateCid
          mandateId
          owner
          agent
          spent = 0.0
          processedReferences = []
        pure (mandateCid, usageCid)

    choice Reject : ()
      controller agent
      do pure ()
