-- Run with: daml test
module Test where

import DA.Time (addRelTime, hours)
import Daml.Script
import Iou
import Mandate


assertUsageState : Party -> ContractId MandateUsage -> Decimal -> Int -> Script ()
assertUsageState viewer usageCid expectedSpent expectedReceiptCount = do
  Some usage <- queryContractId viewer usageCid
  assert (usage.spent == expectedSpent)
  receipts <- query @ChargeReceipt viewer
  assert (length receipts == expectedReceiptCount)


assertAuthorizationState
  : Party
  -> ContractId Mandate
  -> ContractId MandateUsage
  -> Decimal
  -> Int
  -> Script ()
assertAuthorizationState
    viewer mandateCid usageCid expectedSpent expectedReceiptCount = do
  Some _ <- queryContractId viewer mandateCid
  assertUsageState viewer usageCid expectedSpent expectedReceiptCount


testIou : Script ()
testIou = script do
  bank <- allocateParty "Bank"
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  iou <- submit bank do
    createCmd Iou with issuer = bank; owner = alice; amount = 100.0

  submitMustFail bob do exerciseCmd iou Give with newOwner = bob
  iou2 <- submit alice do exerciseCmd iou Give with newOwner = bob
  submitMustFail bob do exerciseCmd iou2 Split with splitAmount = 150.0
  pure ()


testMandateModels : Script ()
testMandateModels = script do
  owner <- allocateParty "Owner"
  agent <- allocateParty "Agent"
  merchant <- allocateParty "Merchant"
  admin <- allocateParty "TokenAdmin"
  stranger <- allocateParty "Stranger"
  now <- getTime
  let deadline = addRelTime now (hours 24)

  mandateCid <- submit owner do
    createCmd Mandate with
      owner
      agent
      instrumentId = "Amulet"
      expectedAdmin = admin
      totalCap = 100.0
      allowedCounterparties = [merchant]
      expiresAt = deadline

  usageCid <- submit owner do
    createCmd MandateUsage with
      mandateCid
      owner
      agent
      spent = 0.0

  -- The owner is the signatory: neither the observer nor an unrelated party
  -- can fabricate authorization state in the owner's name.
  submitMustFail agent do
    createCmd MandateUsage with mandateCid; owner; agent; spent = 0.0
  submitMustFail stranger do
    createCmd MandateUsage with mandateCid; owner; agent; spent = 0.0

  -- Both owner and designated agent can see the authorization state.
  Some _ <- queryContractId owner mandateCid
  Some _ <- queryContractId agent mandateCid
  Some _ <- queryContractId owner usageCid
  Some _ <- queryContractId agent usageCid
  pure ()


testMandateGrantAndRevoke : Script ()
testMandateGrantAndRevoke = script do
  owner <- allocateParty "GrantOwner"
  agent <- allocateParty "GrantAgent"
  merchant <- allocateParty "GrantMerchant"
  admin <- allocateParty "GrantTokenAdmin"
  stranger <- allocateParty "GrantStranger"
  now <- getTime
  let deadline = addRelTime now (hours 24)
  let proposal = MandateProposal with
        owner
        agent
        instrumentId = "Amulet"
        expectedAdmin = admin
        totalCap = 100.0
        allowedCounterparties = [merchant]
        expiresAt = deadline

  -- A party without owner authority cannot create a grant in the owner's
  -- name, and only the designated agent can accept the pending grant.
  submitMustFail stranger do createCmd proposal
  proposalCid <- submit owner do createCmd proposal
  submitMustFail stranger do exerciseCmd proposalCid Accept
  Some _ <- queryContractId agent proposalCid

  (mandateCid, usageCid) <- submit agent do exerciseCmd proposalCid Accept
  Some _ <- queryContractId owner mandateCid
  Some usage <- queryContractId agent usageCid
  assert (usage.spent == 0.0)

  -- The agent cannot revoke. The owner can revoke without the agent's
  -- signature, leaving usage as terminal audit state but no usable policy.
  submitMustFail agent do exerciseCmd mandateCid Revoke
  Some _ <- queryContractId agent mandateCid
  submit owner do exerciseCmd mandateCid Revoke
  None <- queryContractId agent mandateCid
  Some _ <- queryContractId agent usageCid
  pure ()


testMandateChargeHappyPath : Script ()
testMandateChargeHappyPath = script do
  owner <- allocateParty "ChargeOwner"
  agent <- allocateParty "ChargeAgent"
  merchant <- allocateParty "ChargeMerchant"
  admin <- allocateParty "ChargeTokenAdmin"
  stranger <- allocateParty "ChargeStranger"
  now <- getTime
  let deadline = addRelTime now (hours 24)

  proposalCid <- submit owner do
    createCmd MandateProposal with
      owner
      agent
      instrumentId = "Amulet"
      expectedAdmin = admin
      totalCap = 100.0
      allowedCounterparties = [merchant]
      expiresAt = deadline
  (mandateCid, usage0Cid) <- submit agent do exerciseCmd proposalCid Accept

  -- A normal under-cap charge advances usage and emits exactly one receipt.
  (usage40Cid, receipt40Cid) <- submit agent do
    exerciseCmd usage0Cid Charge with
      merchant
      amount = 40.0
      reference = "order-40"
  None <- queryContractId agent usage0Cid
  Some usage40 <- queryContractId agent usage40Cid
  Some receipt40 <- queryContractId merchant receipt40Cid
  Some _ <- queryContractId owner receipt40Cid
  Some _ <- queryContractId agent receipt40Cid
  None <- queryContractId stranger receipt40Cid
  assert (usage40.spent == 40.0)
  assert (receipt40.mandateCid == mandateCid)
  assert (receipt40.owner == owner)
  assert (receipt40.agent == agent)
  assert (receipt40.merchant == merchant)
  assert (receipt40.instrumentId == "Amulet")
  assert (receipt40.amount == 40.0)
  assert (receipt40.spentBefore == 0.0)
  assert (receipt40.spentAfter == 40.0)
  assert (receipt40.chargedAt == now)
  assert (receipt40.reference == "order-40")

  -- Charging the exact remaining allowance is valid.
  (usage100Cid, receipt100Cid) <- submit agent do
    exerciseCmd usage40Cid Charge with
      merchant
      amount = 60.0
      reference = "order-60"
  None <- queryContractId agent usage40Cid
  Some usage100 <- queryContractId agent usage100Cid
  Some receipt100 <- queryContractId merchant receipt100Cid
  assert (usage100.spent == 100.0)
  assert (receipt100.spentBefore == 40.0)
  assert (receipt100.spentAfter == 100.0)
  receipts <- query @ChargeReceipt agent
  assert (length receipts == 2)
  pure ()


testMandateChargeRejections : Script ()
testMandateChargeRejections = script do
  owner <- allocateParty "RejectOwner"
  agent <- allocateParty "RejectAgent"
  merchant <- allocateParty "AllowedMerchant"
  blockedMerchant <- allocateParty "BlockedMerchant"
  wrongAgent <- allocateParty "WrongAgent"
  admin <- allocateParty "RejectTokenAdmin"
  now <- getTime
  let deadline = addRelTime now (hours 24)

  proposalCid <- submit owner do
    createCmd MandateProposal with
      owner
      agent
      instrumentId = "Amulet"
      expectedAdmin = admin
      totalCap = 100.0
      allowedCounterparties = [merchant]
      expiresAt = deadline
  (mandateCid, usage0Cid) <- submit agent do exerciseCmd proposalCid Accept

  -- Every forbidden command leaves the original usage and receipt set intact.
  submitMustFail agent do
    exerciseCmd usage0Cid Charge with
      merchant; amount = 0.0; reference = "zero"
  assertAuthorizationState agent mandateCid usage0Cid 0.0 0

  submitMustFail agent do
    exerciseCmd usage0Cid Charge with
      merchant; amount = -1.0; reference = "negative"
  assertAuthorizationState agent mandateCid usage0Cid 0.0 0

  submitMustFail agent do
    exerciseCmd usage0Cid Charge with
      merchant = blockedMerchant; amount = 10.0; reference = "blocked"
  assertAuthorizationState agent mandateCid usage0Cid 0.0 0

  submitMustFail agent do
    exerciseCmd usage0Cid Charge with
      merchant; amount = 101.0; reference = "over-cap"
  assertAuthorizationState agent mandateCid usage0Cid 0.0 0

  submitMustFail wrongAgent do
    exerciseCmd usage0Cid Charge with
      merchant; amount = 10.0; reference = "wrong-agent"
  assertAuthorizationState agent mandateCid usage0Cid 0.0 0

  submitMustFail owner do
    exerciseCmd usage0Cid Charge with
      merchant; amount = 10.0; reference = "owner-is-not-agent"
  assertAuthorizationState agent mandateCid usage0Cid 0.0 0

  -- Once one command consumes the current usage, a command holding the stale
  -- contract ID cannot commit a second successor or receipt.
  (usage30Cid, _) <- submit agent do
    exerciseCmd usage0Cid Charge with
      merchant; amount = 30.0; reference = "winner"
  assertAuthorizationState agent mandateCid usage30Cid 30.0 1

  -- The cap applies to cumulative spend, not only to each charge in isolation.
  submitMustFail agent do
    exerciseCmd usage30Cid Charge with
      merchant; amount = 71.0; reference = "over-remaining"
  assertAuthorizationState agent mandateCid usage30Cid 30.0 1

  submitMustFail agent do
    exerciseCmd usage0Cid Charge with
      merchant; amount = 10.0; reference = "stale"
  assertAuthorizationState agent mandateCid usage30Cid 30.0 1
  pure ()


testMandateInvalidCaps : Script ()
testMandateInvalidCaps = script do
  owner <- allocateParty "InvalidCapOwner"
  agent <- allocateParty "InvalidCapAgent"
  merchant <- allocateParty "InvalidCapMerchant"
  admin <- allocateParty "InvalidCapTokenAdmin"
  now <- getTime
  let deadline = addRelTime now (hours 24)

  submitMustFail owner do
    createCmd MandateProposal with
      owner
      agent
      instrumentId = "Amulet"
      expectedAdmin = admin
      totalCap = 0.0
      allowedCounterparties = [merchant]
      expiresAt = deadline
  submitMustFail owner do
    createCmd MandateProposal with
      owner
      agent
      instrumentId = "Amulet"
      expectedAdmin = admin
      totalCap = -1.0
      allowedCounterparties = [merchant]
      expiresAt = deadline
  proposals <- query @MandateProposal owner
  assert (null proposals)
  pure ()


testMandateUsageBinding : Script ()
testMandateUsageBinding = script do
  owner <- allocateParty "BindingOwner"
  otherOwner <- allocateParty "BindingOtherOwner"
  agent <- allocateParty "BindingAgent"
  rogueAgent <- allocateParty "BindingRogueAgent"
  merchant <- allocateParty "BindingMerchant"
  admin <- allocateParty "BindingTokenAdmin"
  now <- getTime
  let deadline = addRelTime now (hours 24)

  proposalCid <- submit owner do
    createCmd MandateProposal with
      owner
      agent
      instrumentId = "Amulet"
      expectedAdmin = admin
      totalCap = 100.0
      allowedCounterparties = [merchant]
      expiresAt = deadline
  (mandateCid, legitimateUsageCid) <- submit agent do
    exerciseCmd proposalCid Accept

  -- Even an owner-created usage cannot delegate Charge to a different agent
  -- than the immutable mandate names.
  forgedAgentUsageCid <- submit owner do
    createCmd MandateUsage with
      mandateCid
      owner
      agent = rogueAgent
      spent = 0.0
  submitMustFail rogueAgent do
    exerciseCmd forgedAgentUsageCid Charge with
      merchant; amount = 10.0; reference = "forged-agent"
  assertUsageState rogueAgent forgedAgentUsageCid 0.0 0

  -- A usage signed by another owner cannot borrow an existing mandate.
  forgedOwnerUsageCid <- submit otherOwner do
    createCmd MandateUsage with
      mandateCid
      owner = otherOwner
      agent
      spent = 0.0
  submitMustFail agent do
    exerciseCmd forgedOwnerUsageCid Charge with
      merchant; amount = 10.0; reference = "forged-owner"
  assertAuthorizationState agent mandateCid forgedOwnerUsageCid 0.0 0

  -- The legitimate authorization remains untouched by both attempts.
  assertAuthorizationState agent mandateCid legitimateUsageCid 0.0 0
  pure ()


testMandateExpiredCharge : Script ()
testMandateExpiredCharge = script do
  owner <- allocateParty "ExpiredOwner"
  agent <- allocateParty "ExpiredAgent"
  merchant <- allocateParty "ExpiredMerchant"
  admin <- allocateParty "ExpiredTokenAdmin"
  now <- getTime
  let deadline = addRelTime now (hours 1)

  proposalCid <- submit owner do
    createCmd MandateProposal with
      owner
      agent
      instrumentId = "Amulet"
      expectedAdmin = admin
      totalCap = 100.0
      allowedCounterparties = [merchant]
      expiresAt = deadline
  (_, usageCid) <- submit agent do exerciseCmd proposalCid Accept

  -- Expiry is exclusive: a charge at expiresAt is rejected.
  setTime deadline
  submitMustFail agent do
    exerciseCmd usageCid Charge with
      merchant; amount = 10.0; reference = "expired"
  assertUsageState agent usageCid 0.0 0
  pure ()


testMandatePostRevocationCharge : Script ()
testMandatePostRevocationCharge = script do
  owner <- allocateParty "RevokedOwner"
  agent <- allocateParty "RevokedAgent"
  merchant <- allocateParty "RevokedMerchant"
  admin <- allocateParty "RevokedTokenAdmin"
  now <- getTime
  let deadline = addRelTime now (hours 24)

  proposalCid <- submit owner do
    createCmd MandateProposal with
      owner
      agent
      instrumentId = "Amulet"
      expectedAdmin = admin
      totalCap = 100.0
      allowedCounterparties = [merchant]
      expiresAt = deadline
  (mandateCid, usageCid) <- submit agent do exerciseCmd proposalCid Accept

  submit owner do exerciseCmd mandateCid Revoke
  None <- queryContractId agent mandateCid
  submitMustFail agent do
    exerciseCmd usageCid Charge with
      merchant; amount = 10.0; reference = "after-revoke"
  assertUsageState agent usageCid 0.0 0
  pure ()
