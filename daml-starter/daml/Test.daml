-- Run with: daml test
module Test where

import DA.Time (addRelTime, hours)
import Daml.Script
import Iou
import Mandate


testIou : Script ()
testIou = script do
  bank <- allocateParty "Bank"
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"

  iou <- submit bank do
    createCmd Iou with issuer = bank; owner = alice; amount = 100.0

  submitMustFail bob do exerciseCmd iou Give with newOwner = bob
  iou2 <- submit alice do exerciseCmd iou Give with newOwner = bob
  submitMustFail bob do exerciseCmd iou2 Split with splitAmount = 150.0
  pure ()


testMandateModels : Script ()
testMandateModels = script do
  owner <- allocateParty "Owner"
  agent <- allocateParty "Agent"
  merchant <- allocateParty "Merchant"
  admin <- allocateParty "TokenAdmin"
  stranger <- allocateParty "Stranger"
  now <- getTime
  let deadline = addRelTime now (hours 24)

  mandateCid <- submit owner do
    createCmd Mandate with
      owner
      agent
      instrumentId = "Amulet"
      expectedAdmin = admin
      totalCap = 100.0
      allowedCounterparties = [merchant]
      expiresAt = deadline

  usageCid <- submit owner do
    createCmd MandateUsage with
      mandateCid
      owner
      agent
      spent = 0.0

  -- The owner is the signatory: neither the observer nor an unrelated party
  -- can fabricate authorization state in the owner's name.
  submitMustFail agent do
    createCmd MandateUsage with mandateCid; owner; agent; spent = 0.0
  submitMustFail stranger do
    createCmd MandateUsage with mandateCid; owner; agent; spent = 0.0

  -- Both owner and designated agent can see the authorization state.
  Some _ <- queryContractId owner mandateCid
  Some _ <- queryContractId agent mandateCid
  Some _ <- queryContractId owner usageCid
  Some _ <- queryContractId agent usageCid
  pure ()


testMandateGrantAndRevoke : Script ()
testMandateGrantAndRevoke = script do
  owner <- allocateParty "GrantOwner"
  agent <- allocateParty "GrantAgent"
  merchant <- allocateParty "GrantMerchant"
  admin <- allocateParty "GrantTokenAdmin"
  stranger <- allocateParty "GrantStranger"
  now <- getTime
  let deadline = addRelTime now (hours 24)
  let proposal = MandateProposal with
        owner
        agent
        instrumentId = "Amulet"
        expectedAdmin = admin
        totalCap = 100.0
        allowedCounterparties = [merchant]
        expiresAt = deadline

  -- A party without owner authority cannot create a grant in the owner's
  -- name, and only the designated agent can accept the pending grant.
  submitMustFail stranger do createCmd proposal
  proposalCid <- submit owner do createCmd proposal
  submitMustFail stranger do exerciseCmd proposalCid Accept

  (mandateCid, usageCid) <- submit agent do exerciseCmd proposalCid Accept
  Some _ <- queryContractId owner mandateCid
  Some usage <- queryContractId agent usageCid
  assert (usage.spent == 0.0)

  -- The agent cannot revoke. The owner can revoke without the agent's
  -- signature, leaving usage as terminal audit state but no usable policy.
  submitMustFail agent do exerciseCmd mandateCid Revoke
  submit owner do exerciseCmd mandateCid Revoke
  None <- queryContractId agent mandateCid
  Some _ <- queryContractId agent usageCid
  pure ()
